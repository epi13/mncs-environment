{
  "schema_version": "mncs-family.repository-manifest/v0alpha1",
  "repository": "mncs-environment",
  "revision": 6,
  "manifest_location": "in-repository",
  "authority": {
    "note": "mncs-environment owns session composition, authority projection, and campaign lifecycle orchestration."
  },
  "contracts": {
    "provides": [
      {
        "contract": "workspace-discovery",
        "version": "1",
        "kind": "read-only-workspace-discovery",
        "invocation": {
          "kind": "executable",
          "path": "scripts/mncs-env",
          "fixed_argv": [
            "workspace",
            "--root",
            "."
          ]
        },
        "stability": "experimental"
      },
      {
        "contract": "workspace-readiness",
        "version": "1",
        "kind": "read-only-workspace-readiness",
        "effects": [
          "read"
        ],
        "fingerprint_sources": [
          "mncs_env/cli.py",
          "mncs_env/workspace.py"
        ],
        "invocation": {
          "kind": "executable",
          "path": "scripts/mncs-env",
          "fixed_argv": [
            "workspace",
            "--root",
            ".",
            "--summary"
          ]
        },
        "stability": "experimental"
      },
      {
        "contract": "ambient-projection-coherence",
        "version": "1",
        "kind": "semantic-projection-lifecycle-and-interpretation",
        "stability": "experimental",
        "output_scope": "explicit projection declarations; canonical subjects; Store provenance; native reconciliation"
      }
    ],
    "consumes": [
      {
        "contract": "mncs-store.persistent-object",
        "envelope": {
          "op": "any"
        },
        "required": true,
        "evidence_refs": [
          "mncs_env/store_backend.py",
          "mncs_env/session_store.py"
        ]
      },
      {
        "contract": "mncs-store.projection-state",
        "envelope": {
          "op": "any"
        },
        "required": true,
        "evidence_refs": [
          "mncs_env/projection_store.py",
          "mncs_env/store_backend.py"
        ]
      },
      {
        "contract": "mncs-store.commit-feed",
        "envelope": {
          "op": "any"
        },
        "required": true,
        "evidence_refs": [
          "mncs_env/sources.py",
          "mncs_env/store_backend.py"
        ]
      },
      {
        "contract": "mncs-commons.family-change",
        "envelope": {
          "op": "any"
        },
        "required": false,
        "evidence_refs": [
          "mncs_env/family.py"
        ]
      },
      {
        "contract": "mncs-language-service.semantic-query",
        "envelope": {
          "op": "any"
        },
        "required": false,
        "scope": "declared semantic workspaces",
        "evidence_refs": [
          "mncs_env/family.py",
          "mncs_env/semantics.py"
        ]
      },
      {
        "contract": "mncs-automation.coherence-routing",
        "envelope": {
          "op": "any"
        },
        "required": false,
        "evidence_refs": [
          "mncs_env/coherence.py",
          ".mncs/coherence-passes.json"
        ]
      },
      {
        "contract": "mncs-store.binding-observation",
        "required": false,
        "envelope": {
          "op": "any"
        },
        "evidence_refs": [
          "mncs_env/sources.py",
          "mncs_env/store_backend.py"
        ],
        "scope": "bounded replay; older providers retain verified object projection fallback"
      }
    ],
    "tests": [
      {
        "test": "environment-unit-tests",
        "covers": [
          "environment-session",
          "environment-capabilities"
        ],
        "obligation": "self",
        "command": {
          "argv": [
            "python3",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests",
            "-p",
            "test_*.py",
            "-v"
          ],
          "timeout_seconds": 300,
          "toolchain": {
            "repository": "mncs-store",
            "path": "python"
          },
          "toolchain_env": "MNCS_STORE_PYTHON"
        }
      },
      {
        "test": "selected-toolchain-binding",
        "covers": [
          "environment-capabilities"
        ],
        "command": {
          "argv": [
            "python3",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests",
            "-p",
            "test_environment.py",
            "-k",
            "manifest_test_toolchain",
            "-v"
          ],
          "timeout_seconds": 60,
          "toolchain": {
            "repository": "mncs-store",
            "path": "python"
          },
          "toolchain_env": "MNCS_STORE_PYTHON"
        },
        "obligation": "self"
      },
      {
        "test": "environment-worktree-claim-paths",
        "covers": [
          "environment-session",
          "environment-capabilities"
        ],
        "obligation": "self",
        "command": {
          "argv": [
            "python3",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests",
            "-p",
            "test_environment.py",
            "-k",
            "relative_worktree_claim_matches_bound_absolute_provider_path",
            "-v"
          ],
          "timeout_seconds": 60,
          "toolchain": {
            "repository": "mncs-store",
            "path": "python"
          },
          "toolchain_env": "MNCS_STORE_PYTHON"
        }
      },
      {
        "test": "environment-incremental-coherence",
        "covers": [
          "workspace-readiness",
          "environment-session"
        ],
        "obligation": "self",
        "command": {
          "argv": [
            "python3",
            "-m",
            "pytest",
            "tests/test_incremental.py",
            "-q"
          ],
          "timeout_seconds": 90,
          "toolchain": {
            "repository": "mncs-language",
            "path": "target/release/mncs"
          },
          "toolchain_env": "MNCS_BIN"
        }
      }
    ]
  },
  "projection_inventory": ".mncs/projections.json",
  "structure_profile": {
    "repository": "machine-native-complexity-development-specification",
    "path": "profiles/semantic-project.json",
    "identity": "sha256:259e41ea542e7a1400f1471b0316de4fafc888d6f953c8e91165ff2cfe1e78cb"
  },
  "organization": {
    "layout": "mncs.repository-layout/1",
    "surfaces": [
      {
        "path": ".mncs/project-state.json",
        "class": "canonical",
        "authority": "mncs-environment",
        "note": "Authored project intent; execution state is evidence-derived.",
        "artifact_class": "authoritative"
      },
      {
        "path": ".mncs/projections.json",
        "class": "canonical",
        "authority": "mncs-environment",
        "note": "Explicit semantic projection ownership and dependencies.",
        "artifact_class": "authoritative"
      },
      {
        "path": "README.md",
        "class": "generated",
        "note": "Mixed: only delimited semantic region is projection-owned; surrounding authored bytes are protected.",
        "artifact_class": "mixed"
      },
      {
        "path": "ROADMAP.md",
        "class": "generated",
        "note": "Mixed: projected evidence board beside preserved authored intent.",
        "artifact_class": "mixed"
      },
      {
        "path": ".mncs/project-view.json",
        "class": "generated",
        "note": "Derived machine-facing interpretation; never an execution input.",
        "artifact_class": "derived"
      }
    ]
  }
}
