{
  "name": "mncs-environment-development",
  "workspace_root": "../..",
  "workspace_scope": {
    "kind": "workspace",
    "repositories": ["mncs-environment", "mncs-language", "mncs-compiler", "mncs-test", "mncs-store", "mncs-forge", "mncs-automation", "mncs-doc", "mncs-debug", "mncs-doctor"]
  },
  "required_capabilities": ["mncs-environment:workspace-readiness"],
  "services": [
    {
      "identity": "mncs-environment:workspace-readiness",
      "observation_inputs": ["selected-repositories"],
      "observation_max_age_ms": 60000,
      "probe": {"capability": "mncs-environment:workspace-readiness", "argv": []},
      "response_schema": "mncs.environment.workspace-readiness/1",
      "ready_when": {"/scan/status": "complete"},
      "required": true
    }
  ],
  "intent": {
    "goal": "improve mncs-environment through a persistent, discoverable MNCS work context",
    "repositories": ["mncs-environment"],
    "constraints": ["preserve foreign branches and uncommitted work; acquire explicit claims before provider writes"]
  }
}
