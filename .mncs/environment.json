{
  "name": "mncs-environment-development",
  "workspace_root": "../..",
  "workspace_scope": {
    "kind": "workspace",
    "repositories": [
      "mncs-environment",
      "mncs-language",
      "mncs-language-service",
      "mncs-compiler",
      "mncs-stdlib",
      "mncs-vm",
      "mncs-test",
      "mncs-store",
      "mncs-forge",
      "mncs-reference-studies",
      "mncs-automation",
      "mncs-doc",
      "mncs-debug",
      "mncs-doctor"
    ]
  },
  "required_capabilities": [
    "mncs-environment:workspace-readiness"
  ],
  "services": [
    {
      "identity": "mncs-environment:workspace-readiness",
      "observation_inputs": [
        "selected-repositories"
      ],
      "observation_max_age_ms": 60000,
      "probe": {
        "capability": "mncs-environment:workspace-readiness",
        "argv": []
      },
      "response_schema": "mncs.environment.workspace-readiness/1",
      "ready_when": {
        "/scan/status": "complete"
      },
      "required": true
    },
    {
      "identity": "mncs-doctor:compiler-vm-coherence",
      "observation_inputs": [
        "selected-repositories"
      ],
      "observation_max_age_ms": 60000,
      "probe_timeout_seconds": 60,
      "reconcile_timeout_seconds": 1800,
      "probe": {
        "capability": "mncs-doctor:compiler-vm-health",
        "argv": [
          "--smoke",
          "--compact"
        ]
      },
      "reconcile": {
        "capability": "mncs-doctor:compiler-vm-reconcile",
        "argv": [
          "--smoke",
          "--compact",
          "--reconcile-builds"
        ]
      },
      "response_schema": "mncs.doctor.compiler-vm/1",
      "ready_when": {
        "/status": "pass"
      },
      "required": true,
      "response_max_bytes": 65536
    },
    {
      "identity": "mncs-language-service:resident-workspace",
      "observation_inputs": [
        "selected-repositories"
      ],
      "observation_max_age_ms": 60000,
      "reconcile_timeout_seconds": 600,
      "probe": {
        "capability": "mncs-language-service:resident-status",
        "argv": [
          "--workspace",
          {
            "workspace_root": true
          },
          "--repository-roots-json",
          {
            "selected_repository_roots_json": true
          }
        ]
      },
      "reconcile": {
        "capability": "mncs-language-service:resident-reconcile",
        "argv": [
          "--workspace",
          {
            "workspace_root": true
          },
          "--repository-roots-json",
          {
            "selected_repository_roots_json": true
          },
          "--start-timeout",
          "600"
        ]
      },
      "response_schema": "mncs.language-service.resident-status/1",
      "ready_when": {
        "/ready": true
      },
      "required": true,
      "response_max_bytes": 32768
    },
    {
      "identity": "mncs-forge:resident-workspace",
      "observation_inputs": [
        "selected-repositories"
      ],
      "observation_max_age_ms": 60000,
      "probe_timeout_seconds": 10,
      "reconcile_timeout_seconds": 30,
      "probe": {
        "capability": "mncs-forge:resident-status",
        "argv": [
          "--workspace",
          {
            "repository": "mncs-reference-studies",
            "path": "."
          }
        ]
      },
      "reconcile": {
        "capability": "mncs-forge:resident-reconcile",
        "argv": [
          "--workspace",
          {
            "repository": "mncs-reference-studies",
            "path": "."
          }
        ],
        "effect_target": {
          "repository": "mncs-reference-studies"
        }
      },
      "response_schema": "mncs.forge.resident-status/1",
      "ready_when": {
        "/state": "ready"
      },
      "required": false,
      "response_max_bytes": 32768
    }
  ],
  "intent": {
    "goal": "improve mncs-environment through a persistent, discoverable MNCS work context",
    "repositories": [
      "mncs-environment"
    ],
    "constraints": [
      "preserve foreign branches and uncommitted work; acquire explicit claims before provider writes"
    ]
  },
  "execution_roles": {
    "reference": {
      "capability": "mncs-language:cli-toolchain",
      "use_reference_toolchain": true
    },
    "compiler": {
      "capability": "mncs-compiler:compiler-producer"
    },
    "runtime": {
      "capability": "mncs-vm:vm-runtime"
    }
  }
}
