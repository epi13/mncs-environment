{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mncs.environment.rights-context-binding/2",
  "title": "MNCS Environment rights-context binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest",
    "manifest_scope",
    "governance_profile",
    "profile_id",
    "authority",
    "external_metadata_authoritative",
    "context_budget_bytes"
  ],
  "properties": {
    "schema_version": { "const": "mncs.environment.rights-context-binding/2" },
    "manifest": { "type": "string", "minLength": 1, "maxLength": 512 },
    "manifest_scope": { "enum": ["workspace", "working-checkout"] },
    "governance_profile": { "type": "string", "minLength": 1, "maxLength": 512 },
    "profile_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "basis", "source_ref", "scope"],
      "properties": {
        "identity": { "type": "string", "minLength": 1, "maxLength": 120 },
        "basis": { "type": "string", "minLength": 1, "maxLength": 120 },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "external_metadata_authoritative": { "const": false },
    "context_budget_bytes": { "type": "integer", "minimum": 4096, "maximum": 8192 }
  }
}
