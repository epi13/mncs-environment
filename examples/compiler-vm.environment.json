{
  "name": "compiler-vm-integration",
  "workspace_root": "../..",
  "workspace_scope": {
    "kind": "workspace",
    "repositories": [
      "mncs-environment",
      "mncs-language",
      "mncs-compiler",
      "mncs-vm",
      "mncs-test",
      "mncs-store",
      "mncs-forge",
      "mncs-automation",
      "mncs-doc",
      "mncs-debug",
      "mncs-doctor"
    ]
  },
  "required_capabilities": [
    "mncs-compiler:compiler-producer",
    "mncs-vm:vm-runtime"
  ],
  "services": [
    {
      "identity": "mncs-doctor:compiler-vm-coherence",
      "observation_inputs": [
        "selected-repositories"
      ],
      "observation_max_age_ms": 60000,
      "probe": {
        "capability": "mncs-doctor:compiler-vm-health",
        "argv": [
          "--smoke",
          "--compact"
        ]
      },
      "response_schema": "mncs.doctor.compiler-vm/1",
      "ready_when": {
        "/status": "pass"
      },
      "required": true,
      "response_max_bytes": 65536
    }
  ],
  "intent": {
    "goal": "prove explicitly selected reference/compiler/VM composition",
    "repositories": [
      "mncs-environment",
      "mncs-compiler",
      "mncs-vm",
      "mncs-test",
      "mncs-debug",
      "mncs-doctor",
      "mncs-forge"
    ],
    "constraints": [
      "preserve all foreign work; transfer only explicitly owned claims"
    ]
  },
  "execution_roles": {
    "reference": {
      "capability": "mncs-language:cli-toolchain",
      "use_reference_toolchain": true
    },
    "compiler": {
      "capability": "mncs-compiler:compiler-producer"
    },
    "runtime": {
      "capability": "mncs-vm:vm-runtime"
    }
  },
  "execution_compatibility_service": "mncs-doctor:compiler-vm-coherence"
}
