mncs 0.18;
module mncs.environment.demand_tests;
use mncs.environment.demand_correlation_v1;
use mncs.test.assertions;
use mncs.test.suite;
fn text(n: byte) -> (result: [byte; up_to 160]) { return [n]; }
fn fixture(code: u64) -> (result: DemandJoin) {
 return DemandJoin {
 demand: text(1), binding: text(2), start_demand: text(1), end_demand: text(1),
 start_binding: text(2), end_binding: select(code == 3, text(9), text(2)),
 start_request: text(3), end_request: select(code == 8, text(9), text(3)),
 result_demand: text(1), result_request: select(code == 7, text(9), text(3)),
 demand_sequence: 1, start_sequence: 2, end_sequence: select(code == 4, 1, 3), result_sequence: select(code == 9, 2, 4),
 starts: select(code == 2, 2, 1), completions: select(code == 1, 0, 1), results: select(code == 0, 0, 1),
 context_present: code != 5, context_complete: code != 10, observed_result: code != 6
 };
}
test completed_operation_does_not_imply_verified_work() -> (result: TestResult) { let r: DemandJoinResult = correlate(fixture(0)); return from_assertion(equals_bool(true, r.operation_matched && !r.verification_linked && r.reason == 0, 1)); }
test partial_window_is_explicit() -> (result: TestResult) { let r: DemandJoinResult = correlate(fixture(1)); return from_assertion(equals_bool(true, !r.operation_matched && r.reason == 1, 2)); }
test ambiguous_events_are_not_arbitrarily_selected() -> (result: TestResult) { let r: DemandJoinResult = correlate(fixture(2)); return from_assertion(equals_bool(true, !r.operation_matched && r.reason == 2, 3)); }
test changed_binding_cannot_be_backfilled_from_current_state() -> (result: TestResult) { let r: DemandJoinResult = correlate(fixture(3)); return from_assertion(equals_bool(true, !r.operation_matched && r.reason == 3, 4)); }
test completion_must_follow_request_and_invocation() -> (result: TestResult) { let r: DemandJoinResult = correlate(fixture(4)); return from_assertion(equals_bool(true, !r.operation_matched && r.reason == 4, 5)); }
test historical_context_must_be_present_and_complete() -> (result: TestResult) { let a: DemandJoinResult = correlate(fixture(5)); let b: DemandJoinResult = correlate(fixture(10)); return from_assertion(equals_bool(true, a.reason == 5 && b.reason == 5 && !a.operation_matched && !b.operation_matched, 6)); }
test predictions_cannot_be_verified_outcomes() -> (result: TestResult) { let r: DemandJoinResult = correlate(fixture(6)); return from_assertion(equals_bool(true, r.operation_matched && !r.verification_linked && r.reason == 3, 7)); }
test result_must_belong_to_exact_provider_request() -> (result: TestResult) { let r: DemandJoinResult = correlate(fixture(7)); return from_assertion(equals_bool(true, r.operation_matched && !r.verification_linked && r.reason == 3, 8)); }
test completion_request_mismatch_refuses() -> (result: TestResult) { let r: DemandJoinResult = correlate(fixture(8)); return from_assertion(equals_bool(true, !r.operation_matched && r.reason == 3, 9)); }
test outcome_must_follow_completed_operation() -> (result: TestResult) { let r: DemandJoinResult = correlate(fixture(9)); return from_assertion(equals_bool(true, r.operation_matched && !r.verification_linked && r.reason == 4, 10)); }
test joined_observed_verification_is_separate_from_usefulness() -> (result: TestResult) { let r: DemandJoinResult = correlate(fixture(11)); return from_assertion(equals_bool(true, r.operation_matched && r.verification_linked && r.reason == 0, 11)); }
