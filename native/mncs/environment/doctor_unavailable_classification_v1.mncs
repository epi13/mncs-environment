mncs 0.18;

// Classify unavailable Environment bindings in MNCS. Python retains the
// provider-owned evidence record and its sanitization policy.
module mncs.environment.doctor_unavailable_classification_v1;

use mncs.std.application.v1;

record DoctorBindingClassificationInputV1 {
    status: [byte; up_to 32],
    code: [byte; up_to 128]
}

record DoctorClassificationRequestV1 {
    schema_version: [byte; up_to 64],
    bindings: [DoctorBindingClassificationInputV1; up_to 256]
}

record DoctorClassificationResultV1 {
    schema_version: [byte; up_to 64],
    valid: bool,
    binding_count: u64,
    classes: [u64; up_to 256]
}

fn request_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 101, 110, 118, 105, 114, 111, 110, 109, 101, 110, 116, 46, 100, 111, 99, 116, 111, 114, 45, 117, 110, 97, 118, 97, 105, 108, 97, 98, 108, 101, 45, 99, 108, 97, 115, 115, 105, 102, 105, 99, 97, 116, 105, 111, 110, 45, 114, 101, 113, 117, 101, 115, 116, 47, 49];
}

fn result_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 101, 110, 118, 105, 114, 111, 110, 109, 101, 110, 116, 46, 100, 111, 99, 116, 111, 114, 45, 117, 110, 97, 118, 97, 105, 108, 97, 98, 108, 101, 45, 99, 108, 97, 115, 115, 105, 102, 105, 99, 97, 116, 105, 111, 110, 47, 49];
}

fn available_status() -> (result: [byte; up_to 32]) {
    return [97, 118, 97, 105, 108, 97, 98, 108, 101];
}

fn executable_unavailable_code() -> (result: [byte; up_to 128]) {
    return [101, 120, 101, 99, 117, 116, 97, 98, 108, 101, 45, 117, 110, 97, 118, 97, 105, 108, 97, 98, 108, 101];
}

fn toolchain_missing_code() -> (result: [byte; up_to 128]) {
    return [116, 111, 111, 108, 99, 104, 97, 105, 110, 45, 109, 105, 115, 115, 105, 110, 103];
}

fn same_status(left: [byte; up_to 32], right: [byte; up_to 32]) -> (result: bool) {
    if left.len != right.len { return false; }
    iterate i over left carrying equal: bool = true {
        next equal = equal && left[i] == right[i];
    }
    return equal;
}

fn same_code(left: [byte; up_to 128], right: [byte; up_to 128]) -> (result: bool) {
    if left.len != right.len { return false; }
    iterate i over left carrying equal: bool = true {
        next equal = equal && left[i] == right[i];
    }
    return equal;
}

fn classify_binding(binding: DoctorBindingClassificationInputV1) -> (result: u64) {
    if same_status(binding.status, available_status()) { return 0; }
    if same_code(binding.code, executable_unavailable_code()) ||
        same_code(binding.code, toolchain_missing_code()) {
        return 1;
    }
    return 2;
}

fn doctor_unavailable_classification_app_v1(context: ApplicationContext) -> (result: ApplicationExit)
    capability environment_readiness
    effect structured_read authorized_by environment_readiness
    effect structured_write authorized_by environment_readiness
{
    if !context_is_bounded(context) || context.argv_count != 2 {
        return failure([105, 110, 118, 97, 108, 105, 100, 32, 68, 111, 99, 116, 111, 114, 32, 99, 108, 97, 115, 115, 105, 102, 105, 99, 97, 116, 105, 111, 110, 32, 114, 101, 113, 117, 101, 115, 116], 2);
    }
    let request: DoctorClassificationRequestV1 = structured_read(context.argv[0], request_schema());
    let initial: [u64; 256] = [0; 256];
    iterate i over request.bindings carrying classes: [u64; 256] = initial {
        next classes = replace(classes, i, classify_binding(request.bindings[i]));
    }
    let output: DoctorClassificationResultV1 = DoctorClassificationResultV1 {
        schema_version: result_schema(),
        valid: true,
        binding_count: request.bindings.len,
        classes: classes[0..request.bindings.len]
    };
    let published: u64 = structured_write(context.argv[1], result_schema(), output);
    if published == 0 {
        return failure([68, 111, 99, 116, 111, 114, 32, 99, 108, 97, 115, 115, 105, 102, 105, 99, 97, 116, 105, 111, 110, 32, 112, 117, 98, 108, 105, 115, 104, 32, 102, 97, 105, 108, 101, 100], 3);
    }
    return success([]);
}
